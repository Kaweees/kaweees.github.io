{
  "name": "miguelvf.com",
  "version": "1.0.1",
  "private": false,
  "author": {
    "name": "Miguel Villa Floran",
    "url": "https://github.com/kaweees"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start:dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro check && astro build && jampack ./dist",
    "preview": "astro preview --host",
    "sync": "astro sync",
    "astro": "astro",
    "lint": "prettier . --check && eslint --report-unused-disable-directives --max-warnings 0",
    "format": "prettier . --write --ignore-path .gitignore",
    "taze": "taze major -I",
    "taze:minor": "taze minor -w",
    "test": "pnpm commitlint --edit && pnpm format && pnpm lint"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "i": "^0.3.7",
    "katex": "^0.19.0",
    "node-tikzjax": "^1.0.5",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "typewriter-effect": "^3.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@divriots/jampack": "^0.34.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/github-slugger": "^2.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "astro-eslint-parser": "^3.2.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  }
}
